@{
    ViewData["Title"] = "Random Data ";
}
<link rel="stylesheet" href="~/css/Style.css" />

<div class="container">
    <div class="header">
        <h1>Random Data Generator</h1>
    </div>
    <div class="field-list">
        <div class="field-container">
            <input type="text" placeholder="Field Name" />
            <select class="type-dropdown">
                <option value="String">String</option>
                <option value="Number">Number</option>
                <option value="Boolean">Boolean</option>
                <option value="Date">Date</option>
                <option value="firstName">First Name</option>
                <option value="middleName">Middle Name</option>
                <option value="lastName">Surname</option>
                <option value="GUID">GUID</option>
                <option value="gender">Gender</option>
                <option value="ssn">Social Security Number</option>
                <option value="salary">Salary</option>
            </select>
            <button class="deleteField" title="Delete Field">&times;</button>
        </div>
    </div>
    <div>
        <label for="intInput"> Rows: </label>
        <input type="number" id="intInput" class="form-control" />
    </div>
    <div class="add-buttons">
        <button id="addField">+ Add Another Field</button>
        <button id="generateData">Generate Dataset</button>
        <button id="downloadData">Download Dataset</button>
        <select id="selectFormat">
            <option value="CSV">CSV</option>
            <option value="excel">Excel</option>
            <option value="SQL">SQL</option>
            <option value="JSON">JSON</option>
        </select>
    </div>

    <div id="generatedDataTableContainer">
        <table id="generatedDataTable">
            <thead>
                <tr id ="table-header">
                    <!-- Table header dynamically generated -->
                </tr>
            </thead>
            <tbody>
                <!-- Tablo datas dynamically generated -->
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/RandomDataGenerator.js"></script> <!-- importing javascript codes -->
